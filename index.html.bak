<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0b0d12">
  <meta name="color-scheme" content="dark">
  <title>Mesa Virtual - Crônicas de Camelot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
  <!-- Container da interface superior para permitir occultação/expansão -->
  <div id="topo-geral">
    <header class="topo-mesa">
      <h1>Mesa Virtual - Crônicas de Camelot</h1>
      <div class="auth-container" aria-label="Autenticação">
        <div id="form-login" class="form-login">
          <input type="text" id="auth-nick" placeholder="Seu Nick / Nome">
          <input type="password" id="auth-senha" placeholder="Senha">
          <button onclick="fazerLogin()" class="btn-acao">Entrar</button>
          <button onclick="fazerCadastro()" class="btn-secundario">Criar Conta</button>
        </div>
        <div id="status-usuario" style="display: none; align-items: center; gap: 10px;">
          <span style="color: #04d361;">Logado como: <strong id="user-nick-display"></strong></span>
          <span id="badge-mestre" style="display: none; background: #c5a059; color: #121214; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; font-weight: bold;">MESTRE</span>
          <button onclick="fazerLogout()" class="btn-perigo btn-sair">Sair</button>
        </div>
      </div>
    </header>

    <nav class="abas-navegacao">
      <button class="ativo" onclick="mudarAba('ficha', event)">Minha Ficha</button>
      <button onclick="mudarAba('campanhas', event)">Campanhas</button>
      <button id="btn-aba-sistemas" onclick="mudarAba('sistemas', event)" style="display:none;">Sistemas RPG</button>
      <button onclick="mudarAba('grupo', event)">Fichas do Grupo</button>
      <button onclick="mudarAba('mapa', event)">Mapa</button>
      <button onclick="mudarAba('rolagens', event)">Rolagens</button>
      <button onclick="mudarAba('galeria', event)">Chat & Galeria</button>
    </nav>

    <div id="contexto-campanha" class="contexto-campanha" style="display:none;">
      <span class="contexto-campanha-rotulo">🏰 Campanha ativa</span>
      <strong id="campanha-ativa-nome">Carregando...</strong>
      <span class="contexto-campanha-sistema" id="campanha-ativa-sistema">Sistema: —</span>
    </div>
  </div>

  <!-- Central de Ações Rápidas -->
  <div id="acoes-rapidas" class="acoes-rapidas" aria-label="Ações rápidas">
    <button type="button" id="btn-acoes-rapidas" class="btn-acoes-rapidas" aria-expanded="false" aria-controls="menu-acoes-rapidas" aria-label="Abrir ações rápidas" onclick="alternarAcoesRapidas(event)">
      <span class="acoes-rapidas-icone">＋</span>
    </button>

    <div id="menu-acoes-rapidas" class="menu-acoes-rapidas" aria-hidden="true">
      <button type="button" class="acao-rapida acao-rolagem" onclick="acaoRapida('rolagem')">
        <span class="acao-icone">🎲</span><span><strong>Rolar</strong><small>Dados e expressões</small></span>
      </button>
      <button type="button" class="acao-rapida acao-ataque" onclick="acaoRapida('ataque')">
        <span class="acao-icone">⚔️</span><span><strong>Ação / Ataque</strong><small>Rolar uma ação rápida</small></span>
      </button>
      <button type="button" class="acao-rapida acao-vida" onclick="acaoRapida('vida')">
        <span class="acao-icone">❤️</span><span><strong>Alterar Vida</strong><small>Último token tocado</small></span>
      </button>
      <button type="button" class="acao-rapida acao-chat" onclick="acaoRapida('chat')">
        <span class="acao-icone">💬</span><span><strong>Chat & Galeria</strong><small>Ir para comunicação</small></span>
      </button>
      <button type="button" class="acao-rapida acao-nota" onclick="acaoRapida('nota')">
        <span class="acao-icone">📝</span><span><strong>Nota rápida</strong><small>Salvar uma anotação</small></span>
      </button>
      <button type="button" class="acao-rapida acao-mapa" onclick="acaoRapida('mapa')">
        <span class="acao-icone">🗺️</span><span><strong>Ir para o Mapa</strong><small>Abrir a mesa tática</small></span>
      </button>
    </div>
  </div>

  <main>
    <section id="aba-campanhas" class="painel">
      <div class="cabecalho-campanhas">
        <div>
          <span class="eyebrow-galeria">🏰 Távola de Campanhas</span>
          <h2>Campanhas</h2>
          <p class="subtexto-galeria">Cada campanha possui seus próprios personagens, mapas, imagens e recursos. Nada é misturado entre mesas.</p>
        </div>
        <button id="btn-nova-campanha" class="btn-nova-campanha" style="display:none;" onclick="abrirNovaCampanha()">＋ Nova Campanha</button>
      </div>

      <div id="painel-nova-campanha" class="card-secao card-nova-campanha" style="display:none;">
        <h3>👑 Criar nova campanha</h3>
        <p>Escolha um nome para a nova mesa. Ela será criada separada da campanha atual.</p>
        <div class="form-nova-campanha">
          <input id="nova-campanha-nome" type="text" maxlength="80" placeholder="Ex.: A Queda de Avalon">
          <input id="nova-campanha-descricao" type="text" maxlength="180" placeholder="Descrição curta (opcional)">
          <label class="campo-formulario-campanha"><span>⚙️ Sistema RPG</span><select id="nova-campanha-sistema"><option value="">Carregando sistemas...</option></select></label>
          <button onclick="criarNovaCampanha()" class="btn-ficha-principal">⚔️ Criar Campanha</button>
          <button onclick="fecharNovaCampanha()" class="btn-secundario">Cancelar</button>
        </div>
      </div>

      <div id="lista-campanhas" class="lista-campanhas">
        <div class="estado-galeria">Faça login para carregar suas campanhas.</div>
      </div>
    </section>

    <section id="aba-sistemas" class="painel">
      <div class="cabecalho-campanhas">
        <div>
          <span class="eyebrow-galeria">⚙️ Forja das Regras</span>
          <h2>Sistemas RPG</h2>
          <p class="subtexto-galeria">Crie sistemas reutilizáveis. O sistema define a estrutura da ficha; a campanha guarda os personagens.</p>
        </div>
        <button id="btn-novo-sistema" class="btn-nova-campanha" style="display:none;" onclick="abrirNovoSistema()">＋ Novo Sistema</button>
        <button id="btn-instalar-world-trigger" class="btn-nova-campanha" style="display:none; margin-left:8px;" onclick="instalarSistemaWorldTrigger()">🌐 Adicionar World Trigger RPG</button>
      </div>
      <div id="painel-novo-sistema" class="card-secao card-nova-campanha" style="display:none;">
        <h3 id="titulo-editor-sistema">👑 Criar novo sistema</h3>
        <p>Defina as regras e monte visualmente a ficha. A estrutura fica salva dentro do sistema e pode ser reutilizada por várias campanhas.</p>
        <input type="hidden" id="sistema-editando-id">
        <div class="form-sistema">
          <label><span>Nome do sistema</span><input id="novo-sistema-nome" type="text" maxlength="100" placeholder="Ex.: D&D 5e"></label>
          <label><span>Descrição</span><textarea id="novo-sistema-descricao" maxlength="500" rows="2" placeholder="Como funciona este sistema?"></textarea></label>
          <div class="builder-bloco builder-tema-bloco">
            <div class="builder-titulo"><strong>🎨 Identidade visual</strong><small>Defina as cores usadas pela ficha deste sistema.</small></div>
            <div class="builder-tema-grid">
              <label><span>Cor principal</span><input id="sistema-cor-primaria" type="color" value="#c5a059"></label>
              <label><span>Fundo</span><input id="sistema-cor-fundo" type="color" value="#080a0f"></label>
              <label><span>Painel</span><input id="sistema-cor-painel" type="color" value="#151821"></label>
            </div>
          </div>

          <div class="builder-etapa-nav">
            <button type="button" class="builder-etapa ativo" onclick="mudarEtapaBuilder(1)">1. Componentes</button>
            <button type="button" class="builder-etapa" onclick="mudarEtapaBuilder(2)">2. Layout da Ficha</button>
            <button type="button" class="builder-etapa" onclick="mudarEtapaBuilder(3)">3. Pré-visualização</button>
          </div>

          <div id="builder-etapa-1" class="builder-etapa-conteudo ativo">
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>🎲 Dados disponíveis</strong><small>Selecione os dados usados pelo sistema.</small></div>
              <div id="builder-dados" class="builder-chips"></div>
            </div>
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>🛡️ Atributos</strong><button type="button" class="btn-pequeno" onclick="adicionarCampoSistema('atributos')">＋ Adicionar</button></div>
              <div id="builder-atributos" class="builder-lista"></div>
            </div>
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>❤️ Recursos</strong><button type="button" class="btn-pequeno" onclick="adicionarCampoSistema('recursos')">＋ Adicionar</button></div>
              <div id="builder-recursos" class="builder-lista"></div>
            </div>
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>🎯 Perícias</strong><button type="button" class="btn-pequeno" onclick="adicionarCampoSistema('pericias')">＋ Adicionar</button></div>
              <div id="builder-pericias" class="builder-lista"></div>
            </div>
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>📜 Campos livres da ficha</strong><button type="button" class="btn-pequeno" onclick="adicionarCampoSistema('campos')">＋ Adicionar</button></div>
              <div id="builder-campos" class="builder-lista"></div>
            </div>
          </div>

          <div id="builder-etapa-2" class="builder-etapa-conteudo">
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>🧱 Seções da ficha</strong><button type="button" class="btn-pequeno" onclick="adicionarSecaoSistema()">＋ Nova seção</button></div>
              <p class="builder-ajuda">Crie a ordem visual da ficha. Cada seção pode receber componentes do sistema e uma largura de coluna.</p>
              <div id="builder-secoes" class="builder-secoes"></div>
            </div>
          </div>

          <div id="builder-etapa-3" class="builder-etapa-conteudo">
            <div class="builder-bloco">
              <div class="builder-titulo"><strong>👁️ Prévia em tempo real</strong><small>Esta é uma aproximação da ficha que os jogadores verão.</small></div>
              <div id="builder-preview" class="builder-preview"></div>
            </div>
          </div>

          <div class="builder-acoes">
            <button onclick="salvarSistema()" class="btn-ficha-principal">⚒️ Salvar Sistema</button>
            <button onclick="fecharNovoSistema()" class="btn-secundario">Cancelar</button>
          </div>
        </div>
      </div>
      <div id="lista-sistemas" class="lista-campanhas"><div class="estado-galeria">Faça login para carregar os sistemas.</div></div>
    </section>

    <section id="aba-ficha" class="painel ativo">
      <h2>Minha Ficha do Personagem</h2>
      <div class="card-secao">
        <h3>1. Importar Ficha Existente</h3>
        <p>Selecione o arquivo .json gerado na sua ficha local:</p>
        <input type="file" id="arquivo-json" accept=".json" onchange="importarArquivoJSON(event)">
      </div>
      <div class="card-secao" style="margin-top: 15px;">
        <h3>2. Criar Ficha Diretamente na Mesa</h3>
        <p>Crie um novo personagem usando a ficha do sistema da campanha ativa, sem precisar sair da mesa.</p>
        <button onclick="abrirCriadorFicha()" class="btn-ficha-principal">⚔️ Criar Ficha da Campanha</button>
      </div>
      <div class="card-secao" style="margin-top: 15px;">
        <h3>3. Evolução e Sincronização</h3>
        <p>Edite sua ficha para registrar XP, subir de nível, melhorar atributos e atualizar o inventário. Depois, salve as alterações na nuvem.</p>
        <button onclick="salvarFichaNoSupabase()" style="background: #04d361; color: #121214; font-weight: bold; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer;">Salvar/Atualizar Ficha na Nuvem</button>
      </div>
      <div id="container-ficha-carregada" style="margin-top: 20px;">
        <p class="texto-vazio">Faça login e importe um arquivo JSON para visualizar sua ficha.</p>
      </div>
    </section>

    <section id="aba-grupo" class="painel">
      <h2>Fichas dos Cavaleiros da Távola</h2>
      <button onclick="carregarFichasDoGrupo()" style="background: #8257e5; color: #fff; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-bottom: 15px;">Atualizar Lista do Grupo</button>
      <div id="lista-fichas-grupo">
        <p style="color: #a8a8b3;">Carregando fichas...</p>
      </div>
    </section>

    <section id="aba-mapa" class="painel">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
        <h2 style="margin: 0;">Mapa Tático e Mini-VTT</h2>
        <button onclick="alternarModoImersivoMapa()" id="btn-modo-imersivo" style="background: #8257e5; color: #fff; border: none; padding: 6px 14px; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 0.85rem;">
          📐 Maximizar Mapa
        </button>
      </div>

      <!-- Painel retrátil usando a tag <details> -->
      <details id="painel-upload-mestre" style="display: none; background: #202024; padding: 10px 15px; border-radius: 6px; margin-bottom: 15px; border: 1px solid #c5a059;">
        <summary style="color: #c5a059; font-weight: bold; cursor: pointer; font-size: 0.95rem; user-select: none;">
          👑 Painel do Mestre: Enviar Novo Mapa (clique para recolher/expandir)
        </summary>
        <div style="margin-top: 12px; border-top: 1px solid #29292e; padding-top: 10px;">
          <input type="file" id="arquivo-mapa" accept="image/*" style="margin-bottom: 10px; display: block;">
          <button onclick="fazerUploadMapa()" style="background: #c5a059; color: #121214; font-weight: bold; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Publicar Mapa para o Grupo</button>
        </div>
      </details>

      <div id="container-mapa">
        <p style="color: #a8a8b3;">Nenhum mapa carregado no momento.</p>
      </div>
    </section>

    <section id="aba-rolagens" class="painel">
      <h2>Salão de Rolagens de Dados</h2>
      <div style="background: #202024; padding: 15px; border-radius: 6px; margin-bottom: 15px;">
        <h3>Rolagem Rápida</h3>
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;">
          <button onclick="rolarDado(4)">d4</button>
          <button onclick="rolarDado(6)">d6</button>
          <button onclick="rolarDado(8)">d8</button>
          <button onclick="rolarDado(10)">d10</button>
          <button onclick="rolarDado(12)">d12</button>
          <button onclick="rolarDado(20)">d20</button>
          <button onclick="rolarDado(100)">d100</button>
        </div>
      </div>
      <div style="background: #202024; padding: 15px; border-radius: 6px; margin-bottom: 15px;">
        <h3>Expressão Personalizada</h3>
        <div style="display: flex; gap: 10px; margin-top: 10px;">
          <input type="text" id="expressao-dado" placeholder="ex: 2d20+5" style="flex: 1; padding: 8px; background: #121214; border: 1px solid #29292e; color: #fff; border-radius: 4px;">
          <button onclick="rolarExpressaoPersonalizada()" style="background: #8257e5; color: #fff; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">Rolar</button>
        </div>
      </div>
      <div>
        <h3>Histórico de Rolagens</h3>
        <div id="historico-rolagens" style="margin-top: 10px; max-height: 250px; overflow-y: auto;">
          <p style="color: #a8a8b3;">Nenhuma rolagem realizada ainda.</p>
        </div>
      </div>
    </section>

    <section id="aba-galeria" class="painel">
      <div class="cabecalho-galeria">
        <div>
          <span class="eyebrow-galeria">📚 Biblioteca visual da campanha</span>
          <h2>Galeria e Recursos Visuais</h2>
          <p class="subtexto-galeria">Organize imagens por pastas e escolha o que fica visível para o grupo.</p>
        </div>
        <div id="status-galeria" class="status-galeria">Sincronizada</div>
      </div>

      <div id="painel-galeria-mestre" class="card-galeria-mestre" style="display:none;">
        <div class="titulo-painel-galeria">
          <div>
            <strong>👑 Biblioteca do Mestre</strong>
            <small>Envie e organize os recursos visuais da campanha.</small>
          </div>
        </div>
        <div class="form-galeria-mestre">
          <label class="campo-galeria">
            <span>Imagem</span>
            <input type="file" id="arquivo-imagem" accept="image/*">
          </label>
          <label class="campo-galeria">
            <span>Nome</span>
            <input type="text" id="nome-imagem" maxlength="120" placeholder="Ex.: Retrato de Arthur">
          </label>
          <label class="campo-galeria">
            <span>Pasta</span>
            <input type="text" id="pasta-imagem" maxlength="60" value="Geral" placeholder="Ex.: NPCs">
          </label>
          <label class="campo-galeria">
            <span>Visibilidade</span>
            <select id="visibilidade-imagem">
              <option value="publica">🌐 Visível para os jogadores</option>
              <option value="oculta">🔒 Oculta para os jogadores</option>
            </select>
          </label>
          <button onclick="fazerUploadImagem()" class="btn-publicar-galeria">📤 Adicionar à Biblioteca</button>
        </div>
      </div>

      <div class="barra-pastas-galeria">
        <div>
          <span class="rotulo-pastas">PASTAS</span>
          <div id="galeria-pastas" class="galeria-pastas">
            <button class="pasta-galeria ativa" onclick="filtrarGaleriaPasta('Todas', event)">📚 Todas</button>
          </div>
        </div>
        <button id="btn-atualizar-galeria" class="btn-atualizar-galeria" onclick="carregarGaleria(true)">↻ Atualizar</button>
      </div>

      <div id="galeria-grid" class="galeria-grid-profissional">
        <div class="estado-galeria">Carregando biblioteca...</div>
      </div>
    </section>
  </main>

  <div id="modal-imagem-mestre" class="modal-imagem-mestre" style="display:none;" role="dialog" aria-modal="true" aria-label="Imagem compartilhada pelo Mestre">
    <div class="imagem-mestre-backdrop" onclick="fecharImagemMestre()"></div>
    <div class="imagem-mestre-conteudo">
      <div class="imagem-mestre-cabecalho">
        <div>
          <span class="imagem-mestre-kicker">👑 O MESTRE MOSTROU</span>
          <h2 id="imagem-mestre-titulo">Imagem da campanha</h2>
          <span id="imagem-mestre-pasta" class="imagem-mestre-pasta">Geral</span>
        </div>
        <button type="button" onclick="fecharImagemMestre()" class="btn-fechar-imagem-mestre" aria-label="Fechar imagem">✕</button>
      </div>
      <div class="imagem-mestre-palco">
        <img id="imagem-mestre-preview" src="" alt="Imagem compartilhada pelo Mestre">
      </div>
    </div>
  </div>

  <div id="modal-ficha-grupo" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); z-index: 9998; justify-content: center; align-items: center; padding: 20px;">
    <div class="modal-ficha-grupo-conteudo">
      <div style="background: #1a1d26; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #c5a059;">
        <h2 id="modal-titulo-personagem" style="color: #f3d075; font-size: 1.2rem; margin: 0;">Ficha do Cavaleiro</h2>
        <button onclick="fecharModalFichaGrupo()" style="background: #ff5252; color: #fff; border: none; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-weight: bold;">✕ Fechar</button>
      </div>
      <div id="modal-conteudo-ficha" class="modal-ficha-grupo-body"></div>
    </div>
  </div>

  <!-- Editor completo da ficha dentro da Mesa -->
  <div id="modal-criador-ficha" class="modal-ficha-completa" style="display:none;">
    <div class="modal-ficha-completa-conteudo">
      <div class="modal-ficha-cabecalho">
        <h2>⚔️ Criar Nova Ficha — Crônicas de Camelot</h2>
        <button onclick="fecharCriadorFicha()" class="btn-fechar-modal">✕ Fechar</button>
      </div>
      <iframe id="iframe-criador-ficha" title="Criador de Ficha Crônicas de Camelot" src="about:blank"></iframe>
    </div>
  </div>

  <div id="toast-container"></div>

  <div id="status-conexao" class="status-conexao" aria-live="polite"><span class="status-ponto"></span><span id="status-conexao-texto">Conectando à Távola...</span></div>

  <script src="app.js"></script>
</body>
</html>
